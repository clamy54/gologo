; CARAPOUSSE - Librement inspiré par sokoban. 
; le bonhomme pousse les carapaces sur les cibles, une par case.
; Fleches pour bouger, R pour recommencer le niveau, Q pour quitter.
; Un niveau est une liste de lignes de lettres : M mur, S sol, O cible,
; C carapace, J joueur, K carapace deja sur cible, L joueur sur cible.

; ---- lit un niveau (liste de lignes), remplit les tableaux, met la grille a l'echelle ----
POUR PREPARE :ROWS
LOCAL [ R C CH LIGNE CW CH2 ]
DONNE "H COMPTE :ROWS
DONNE "W COMPTE ITEM 1 :ROWS
DONNE "CX ( :W + 1 ) / 2
DONNE "CY ( :H + 1 ) / 2
DONNE "CW 1380 / :W
DONNE "CH2 740 / :H
SI :CW < :CH2 [ DONNE "CELL :CW ] [ DONNE "CELL :CH2 ]
SI :CELL > 80 [ DONNE "CELL 80 ]
DONNE "WALL TABLEAUMD ( LISTE :H :W )
DONNE "TARG TABLEAUMD ( LISTE :H :W )
DONNE "BOX TABLEAUMD ( LISTE :H :W )
REPETEPOUR [ R 1 :H ] [
REPETEPOUR [ C 1 :W ] [
FIXEITEMMD ( LISTE :R :C ) :WALL 0
FIXEITEMMD ( LISTE :R :C ) :TARG 0
FIXEITEMMD ( LISTE :R :C ) :BOX 0
] ]
REPETEPOUR [ R 1 :H ] [
DONNE "LIGNE ITEM :R :ROWS
REPETEPOUR [ C 1 :W ] [
DONNE "CH ITEM :C :LIGNE
SI EGAL? :CH "M [ FIXEITEMMD ( LISTE :R :C ) :WALL 1 ]
SI OU EGAL? :CH "O OU EGAL? :CH "K EGAL? :CH "L [ FIXEITEMMD ( LISTE :R :C ) :TARG 1 ]
SI OU EGAL? :CH "C EGAL? :CH "K [ FIXEITEMMD ( LISTE :R :C ) :BOX 1 ]
SI OU EGAL? :CH "J EGAL? :CH "L [ DONNE "PR :R DONNE "PC :C ]
] ]
DONNE "MOVES 0
FIN

POUR MUR? :R :C
RENDS EGAL? ( ITEMMD ( LISTE :R :C ) :WALL ) 1
FIN

POUR CAISSE? :R :C
RENDS EGAL? ( ITEMMD ( LISTE :R :C ) :BOX ) 1
FIN

; ---- tente un pas (DR DC) ; pousse la carapace devant si la case d'apres est libre ----
POUR DEPLACE :DR :DC
LOCAL [ NR NC MR MC ]
DONNE "NR :PR + :DR
DONNE "NC :PC + :DC
SI MUR? :NR :NC [ STOP ]
SI CAISSE? :NR :NC [
DONNE "MR :NR + :DR
DONNE "MC :NC + :DC
SI MUR? :MR :MC [ STOP ]
SI CAISSE? :MR :MC [ STOP ]
FIXEITEMMD ( LISTE :NR :NC ) :BOX 0
FIXEITEMMD ( LISTE :MR :MC ) :BOX 1
]
DONNE "PR :NR
DONNE "PC :NC
DONNE "MOVES :MOVES + 1
FIN

; ---- gagne quand plus aucune carapace n'est en dehors d'une cible ----
POUR GAGNE?
LOCAL [ R C RESTE ]
DONNE "RESTE 0
REPETEPOUR [ R 1 :H ] [
REPETEPOUR [ C 1 :W ] [
SI CAISSE? :R :C [ SI NON EGAL? ( ITEMMD ( LISTE :R :C ) :TARG ) 1 [ DONNE "RESTE :RESTE + 1 ] ]
] ]
RENDS EGAL? :RESTE 0
FIN

; ---- coordonnees ecran du centre d'une case ----
POUR XC :C
RENDS ( :C - :CX ) * :CELL
FIN
POUR YR :R
RENDS ( :CY - :R ) * :CELL
FIN

; ---- un disque plein (diametre DIAM) centre en X Y ----
POUR DISQUE :X :Y :DIAM :COUL
FCC :COUL FIXETAILLECRAYON :DIAM
LC FXY ( :X - 1 ) :Y BC FXY ( :X + 1 ) :Y LC
FIN

; ---- un carre plein (cote S) par lignes de balayage : des bords bien droits ----
POUR PAVE :X :Y :S :COUL
LOCAL [ H YY E ]
DONNE "H :S / 2
DONNE "E 6
FCC :COUL FIXETAILLECRAYON :E
DONNE "YY :Y - :H
TANTQUE [ :YY <= :Y + :H ] [
LC FXY ( :X - :H ) :YY BC FXY ( :X + :H ) :YY LC
DONNE "YY :YY + :E
]
FIN

; ---- une brique de mur (carre plein + traits de mortier decales) ----
POUR MUR :R :C
LOCAL [ X Y H VX ]
DONNE "X XC :C
DONNE "Y YR :R
DONNE "H :CELL / 2
PAVE :X :Y :CELL :CMUR
FCC :CMORTIER FIXETAILLECRAYON 2
LC FXY ( :X - :H ) ( :Y + :H * 0.34 ) BC FXY ( :X + :H ) ( :Y + :H * 0.34 ) LC
LC FXY ( :X - :H ) ( :Y - :H * 0.34 ) BC FXY ( :X + :H ) ( :Y - :H * 0.34 ) LC
SI EGAL? ( RESTE :R 2 ) 0 [ DONNE "VX :X ] [ DONNE "VX :X - :H ]
LC FXY :VX ( :Y + :H ) BC FXY :VX ( :Y + :H * 0.34 ) LC
LC FXY :VX ( :Y - :H ) BC FXY :VX ( :Y - :H * 0.34 ) LC
FIN

; ---- une carapace verte dans la case R C ----
POUR CARAPACE :R :C :COUL
LOCAL [ X Y D I ]
DONNE "X XC :C
DONNE "Y YR :R
DONNE "D :CELL
DISQUE :X :Y ( :D * 0.52 ) :COUL
FCC :CONTOUR FIXETAILLECRAYON 2
LC FXY :X :Y BC CERCLE ( :D * 0.26 )
LC FXY :X :Y BC CERCLE ( :D * 0.10 )
REPETEPOUR [ I 0 5 ] [
LC FXY :X :Y FCAP ( :I * 60 ) AV ( :D * 0.10 ) BC AV ( :D * 0.16 ) LC
]
FIN

; ---- repere du bonhomme : U vers l'avant (le cap HD), R sur sa droite ----
POUR PX :U :R
RENDS :BX + ( :U * ( SIN :HD ) ) + ( :R * ( COS :HD ) )
FIN
POUR PY :U :R
RENDS :BY + ( :U * ( COS :HD ) ) - ( :R * ( SIN :HD ) )
FIN
POUR TRAIT :U1 :R1 :U2 :R2
LC FXY ( PX :U1 :R1 ) ( PY :U1 :R1 ) BC FXY ( PX :U2 :R2 ) ( PY :U2 :R2 ) LC
FIN
POUR POINTBF :U :R
LC FXY ( PX :U :R ) ( PY :U :R ) BC FXY ( PX :U :R ) ( PY :U :R ) LC
FIN

; ---- le bonhomme dans la case R C, pivote vers la direction FACE (1 5 7 3) ----
POUR BONHOMME :R :C :FACE
LOCAL [ D ]
DONNE "BX XC :C
DONNE "BY YR :R
DONNE "D :CELL
DONNE "HD 0
SI EGAL? :FACE 1 [ DONNE "HD 180 ]
SI EGAL? :FACE 3 [ DONNE "HD 270 ]
SI EGAL? :FACE 7 [ DONNE "HD 90 ]
FCC :CPANT FIXETAILLECRAYON :D * 0.12
TRAIT ( 0 - :D * 0.05 ) ( 0 - :D * 0.09 ) ( 0 - :D * 0.30 ) ( 0 - :D * 0.09 )
TRAIT ( 0 - :D * 0.05 ) ( :D * 0.09 ) ( 0 - :D * 0.30 ) ( :D * 0.09 )
FCC :CCHEMISE FIXETAILLECRAYON :D * 0.26
TRAIT ( 0 - :D * 0.05 ) 0 ( :D * 0.14 ) 0
FCC :CCHEMISE FIXETAILLECRAYON :D * 0.09
TRAIT ( :D * 0.09 ) 0 ( :D * 0.01 ) ( 0 - :D * 0.20 )
TRAIT ( :D * 0.09 ) 0 ( :D * 0.01 ) ( :D * 0.20 )
FCC :CPEAU FIXETAILLECRAYON :D * 0.23
POINTBF ( :D * 0.27 ) 0
FCC :CCHEVEUX FIXETAILLECRAYON :D * 0.09
LC FXY ( PX ( :D * 0.27 ) 0 ) ( PY ( :D * 0.27 ) 0 ) BC ARC ( :D * 0.12 ) ( :HD - 90 ) ( :HD + 90 ) LC
FCC :CCHEVEUX FIXETAILLECRAYON :D * 0.06
POINTBF ( :D * 0.30 ) ( 0 - :D * 0.05 )
POINTBF ( :D * 0.30 ) ( :D * 0.05 )
FIN

; ---- toute la grille : cibles, murs, carapaces, puis le bonhomme ----
POUR DESSINEGRILLE
LOCAL [ R C ]
REPETEPOUR [ R 1 :H ] [
REPETEPOUR [ C 1 :W ] [
SI EGAL? ( ITEMMD ( LISTE :R :C ) :TARG ) 1 [ DISQUE ( XC :C ) ( YR :R ) ( :CELL * 0.22 ) :CCIBLE ]
SI MUR? :R :C [ MUR :R :C ]
SI CAISSE? :R :C [
SI EGAL? ( ITEMMD ( LISTE :R :C ) :TARG ) 1 [ CARAPACE :R :C :CBOXOK ] [ CARAPACE :R :C :CBOX ]
]
] ]
BONHOMME :PR :PC :FACE
FIN

POUR HUD
CENTRE ( PHRASE [ NIVEAU ] :NIV [ SUR ] :TOTAL [ - COUPS ] :MOVES ) 24 470 :CTEXTE
CENTRE [ FLECHES DEPLACER   R RECOMMENCER   Q QUITTER ] 41 -442 :CTEXTE
FIN

; ---- texte centre horizontalement (N = nb de caracteres), a la hauteur Y ----
POUR CENTRE :TXT :N :Y :COUL
FCC :COUL LC FXY ( 0 - :N * 11.67 ) :Y ETIQUETTE :TXT
FIN

; ---- une image complete, double tampon (pas de clignotement) ----
POUR DESSINE
SCENE [ NETTOIE DESSINEGRILLE HUD ]
FIN

; ---- lit les fleches (manette) et les touches R / Q ----
POUR TICK
LOCAL [ J K ]
SI TOUCHE? [
DONNE "K MAJUSCULE LISCAR
SI EGAL? :K "R [ PREPARE ITEM :NIV :NIVEAUX DONNE "LASTDIR 0 DONNE "FACE 5 DESSINE ]
SI EGAL? :K "Q [ DONNE "ABANDON VRAI STOP ]
]
DONNE "J MANETTE 0
SI EGAL? :J :LASTDIR [ STOP ]
DONNE "LASTDIR :J
SI EGAL? :J 1 [ DONNE "FACE 1 DEPLACE -1 0 DESSINE ]
SI EGAL? :J 5 [ DONNE "FACE 5 DEPLACE 1 0 DESSINE ]
SI EGAL? :J 7 [ DONNE "FACE 7 DEPLACE 0 -1 DESSINE ]
SI EGAL? :J 3 [ DONNE "FACE 3 DEPLACE 0 1 DESSINE ]
FIN

; ---- deroule un niveau jusqu'a la victoire ou l'abandon ----
POUR MANCHE
DONNE "LASTDIR 0
DONNE "FACE 5
DONNE "ABANDON FAUX
DESSINE
TANTQUE [ NON GAGNE? ] [
TICK
SI :ABANDON [ STOP ]
ATTENDS 1
]
FIN

POUR ECRANTITRE
SCENE [
NETTOIE
CENTRE [ C A R A P O U S S E ] 19 120 :CGAGNE
CENTRE [ LE BONHOMME POUSSE CHAQUE CARAPACE SUR UNE CIBLE ] 50 30 :CTEXTE
CENTRE [ FLECHES POUR DEPLACER ] 21 -40 :CTEXTE
CENTRE [ R RECOMMENCER   Q QUITTER ] 23 -100 :CTEXTE
CENTRE [ ESPACE POUR COMMENCER ] 21 -190 :CCIBLE
]
DONNE "K LISCAR
FIN

POUR ECRANGAGNE
SCENE [
NETTOIE DESSINEGRILLE
CENTRE [ NIVEAU RESOLU ! ] 15 30 :CGAGNE
CENTRE [ ESPACE POUR CONTINUER ] 21 -40 :CTEXTE
]
DONNE "K LISCAR
FIN

POUR ECRANFINAL
SCENE [
NETTOIE
CENTRE [ B R A V O ! ] 11 60 :CGAGNE
CENTRE [ TOUTES LES CARAPACES SONT RANGEES ] 32 -20 :CTEXTE
]
FIN

POUR START
VE CT FEN
FCFG [ 224 218 170 ]
DONNE "CMUR [ 196 168 116 ]
DONNE "CMORTIER [ 150 120 78 ]
DONNE "CCIBLE [ 208 148 138 ]
DONNE "CBOX [ 95 165 70 ]
DONNE "CBOXOK [ 70 120 52 ]
DONNE "CONTOUR [ 32 60 32 ]
DONNE "CCHEMISE [ 60 110 200 ]
DONNE "CPANT [ 50 58 86 ]
DONNE "CPEAU [ 235 198 152 ]
DONNE "CCHEVEUX [ 35 32 34 ]
DONNE "CTEXTE [ 80 66 38 ]
DONNE "CGAGNE [ 70 130 50 ]
DONNE "NIVEAUX [
[ SSSSMMMMMSSSSSSSSSS SSSSMSSSMSSSSSSSSSS SSSSMCSSMSSSSSSSSSS SSMMMSSCMMSSSSSSSSS SSMSSCSCSMSSSSSSSSS MMMSMSMMSMSSSMMMMMM MSSSMSMMSMMMMMSSOOM MSCSSCSSSSSSSSSSOOM MMMMMSMMMSMJMMSSOOM SSSSMSSSSSMMMMMMMMM SSSSMMMMMMMSSSSSSSS ]
