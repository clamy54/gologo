POUR COULEUR :N
DONNE "A1 :N * 10
DONNE "A2 :A1 + 120
DONNE "A3 :A1 + 240
DONNE "R 128 + 120 * SIN :A1
DONNE "V 128 + 120 * SIN :A2
DONNE "BL 128 + 120 * SIN :A3
RENDS PHRASE :R PHRASE :V :BL
FIN

POUR ITERE :CR :CI
DONNE "ZX 0
DONNE "ZY 0
DONNE "ZX2 0
DONNE "ZY2 0
DONNE "N 0
TANTQUE [ ET ( ( :ZX2 + :ZY2 ) < 4 ) ( :N < :MAX ) ] [
DONNE "ZY 2 * :ZX * :ZY + :CI
DONNE "ZX :ZX2 - :ZY2 + :CR
DONNE "ZX2 :ZX * :ZX
DONNE "ZY2 :ZY * :ZY
DONNE "N :N + 1
]
RENDS :N
FIN

POUR START
VE CT FCFG 0
DONNE "PAS 4
DONNE "MAX 80
DONNE "DEMI :PAS / 2
DONNE "XMAX 800 - :DEMI
FIXETAILLECRAYON :PAS * 0.6 + 1
REPETEPOUR [ LY -500 500 :PAS ] [
DONNE "CI :LY * 0.0025
REPETEPOUR [ LX 0 - :XMAX :XMAX :PAS ] [
DONNE "CR -0.5 + :LX * 0.0025
DONNE "N ITERE :CR :CI
SI :N = :MAX [ FCC 0 ] [ FCC COULEUR :N ]
LC FXY :LX - :DEMI :LY BC FXY :LX + :DEMI :LY LC
]
]
FIN
