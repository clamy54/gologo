POUR PROJETTE :X :Y :Z
DONNE "X1 :X * :CA + :Z * :SA
DONNE "Z1 :Z * :CA - :X * :SA
DONNE "Y2 :Y * :CB - :Z1 * :SB
DONNE "Z2 :Y * :SB + :Z1 * :CB
DONNE "PE 6 / ( 8 - :Z2 )
DONNE "PX :X1 * :PE * :TAILLE
DONNE "PY ( :Y2 * :PE * :TAILLE ) + :CY
FIN

POUR ARETE :XA :YA :ZA :XB :YB :ZB
PROJETTE :XA :YA :ZA
LC FXY :PX :PY
PROJETTE :XB :YB :ZB
BC FXY :PX :PY LC
FIN

POUR CUBE
ARETE -1 -1 1 1 -1 1
ARETE 1 -1 1 1 1 1
ARETE 1 1 1 -1 1 1
ARETE -1 1 1 -1 -1 1
ARETE -1 -1 -1 1 -1 -1
ARETE 1 -1 -1 1 1 -1
ARETE 1 1 -1 -1 1 -1
ARETE -1 1 -1 -1 -1 -1
ARETE -1 -1 1 -1 -1 -1
ARETE 1 -1 1 1 -1 -1
ARETE 1 1 1 1 1 -1
ARETE -1 1 1 -1 1 -1
FIN

POUR TITRE
FCC 3 LC
FXY -70 430 ETIQUETTE "GOLOGO
FXY -152 380 ETIQUETTE [ BY CYRIL LAMY ]
FIN

POUR START
VE CT FCFG 0
DONNE "TAILLE 150
DONNE "CY -40
DONNE "AX 25
DONNE "AY 0
TANTQUE [ NON TOUCHE? ] [
NETTOIE
TITRE
DONNE "CA COS :AY
DONNE "SA SIN :AY
DONNE "CB COS :AX
DONNE "SB SIN :AX
FCC 7 LC
CUBE
DONNE "AY :AY + 4
DONNE "AX :AX + 2
SI :AY > 360 [ DONNE "AY :AY - 360 ]
SI :AX > 360 [ DONNE "AX :AX - 360 ]
ATTENDS 2
]
FIN
