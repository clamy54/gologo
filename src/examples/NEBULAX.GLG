POUR START
PREPARE
TANTQUE [ ET (NON :GA) (NON :WON) ] [
PILOTE
TIRS
ESSAIM
BOMBE
SCENE [ NETTOIE RENDU ]
ATTENDS 2
]
SCENE [ NETTOIE RENDU FINJEU ]
FIN

POUR PREPARE
VE CT FEN
DONNE "COLS 6
DONNE "ROWS 4
DONNE "AW 95
DONNE "AH 78
DONNE "PY 0 - 400
DONNE "FOND [ 8 10 22 ]
DONNE "VERT [ 96 220 130 ]
DONNE "CYAN [ 120 220 240 ]
DONNE "BLANC [ 245 245 210 ]
DONNE "ROUGE [ 240 110 90 ]
DONNE "TXT [ 200 220 200 ]
FCFG :FOND
DONNE "SCORE 0
DONNE "LIVES 3
DONNE "GA "FAUX
DONNE "WON "FAUX
DONNE "DIR 1
DONNE "STEP 0
DONNE "FX 0 - 237
DONNE "FY 350
DONNE "PX 0
DONNE "BACT "FAUX
DONNE "BOMBS [ ]
DONNE "MAXBOMBS 5
NICHEE
FIN

POUR NICHEE
DONNE "GRILLE [ ]
REPETE :ROWS [ DONNE "GRILLE MD "111111 :GRILLE ]
FIN

POUR VIVANT? :C :R
RENDS (ITEM (:C + 1) (ITEM (:R + 1) :GRILLE)) = "1
FIN

POUR SETCAR :W :I :V
LOCAL "R DONNE "R "
REPETEPOUR [ J 1 (COMPTE :W) ] [ SI :J = :I [ DONNE "R MOT :R :V ] [ DONNE "R MOT :R ITEM :J :W ] ]
RENDS :R
FIN

POUR SETROW :LST :N :VAL
LOCAL "R DONNE "R [ ]
REPETEPOUR [ J 1 (COMPTE :LST) ] [ SI :J = :N [ DONNE "R MD :VAL :R ] [ DONNE "R MD (ITEM :J :LST) :R ] ]
RENDS :R
FIN

POUR TUE :C :R
LOCAL "ROW DONNE "ROW ITEM (:R + 1) :GRILLE
DONNE "GRILLE SETROW :GRILLE (:R + 1) (SETCAR :ROW (:C + 1) "0)
FIN

POUR VIVANTS
LOCAL "N DONNE "N 0
REPETEPOUR [ R 0 :ROWS - 1 ] [ REPETEPOUR [ C 0 :COLS - 1 ] [ SI VIVANT? :C :R [ DONNE "N :N + 1 ] ] ]
RENDS :N
FIN

POUR COLVIVE? :C
LOCAL "V DONNE "V "FAUX
REPETEPOUR [ R 0 :ROWS - 1 ] [ SI VIVANT? :C :R [ DONNE "V "VRAI ] ]
RENDS :V
FIN

POUR MINC
REPETEPOUR [ C 0 :COLS - 1 ] [ SI COLVIVE? :C [ RENDS :C ] ]
RENDS 0
FIN

POUR MAXC
REPETEPOUR [ C 0 :COLS - 1 ] [ LOCAL "M DONNE "M :COLS - 1 - :C SI COLVIVE? :M [ RENDS :M ] ]
RENDS :COLS - 1
FIN

POUR BASDE :C
LOCAL "B DONNE "B 0 - 1
REPETEPOUR [ R 0 :ROWS - 1 ] [ SI VIVANT? :C :R [ DONNE "B :R ] ]
RENDS :B
FIN

POUR PILOTE
LOCAL "D DONNE "D MANETTE 0
SI :D = 7 [ DONNE "PX :PX - 14 ]
SI :D = 3 [ DONNE "PX :PX + 14 ]
SI :PX < 0 - 700 [ DONNE "PX 0 - 700 ]
SI :PX > 700 [ DONNE "PX 700 ]
LOCAL "F DONNE "F BOUTON? 0
SI ET :F (NON :BACT) [ DONNE "BACT "VRAI DONNE "BX :PX DONNE "BY :PY + 40 ]
FIN

POUR TIRS
SI NON :BACT [ STOP ]
DONNE "BY :BY + 30
SI :BY > 470 [ DONNE "BACT "FAUX STOP ]
REPETEPOUR [ R 0 :ROWS - 1 ] [ REPETEPOUR [ C 0 :COLS - 1 ] [
SI VIVANT? :C :R [ SI IMPACT :C :R [ TUE :C :R DONNE "SCORE :SCORE + 10 DONNE "BACT "FAUX ] ]
] ]
FIN

POUR IMPACT :C :R
LOCAL "AX DONNE "AX :FX + :C * :AW
LOCAL "AY DONNE "AY :FY - :R * :AH
RENDS ET ((VALABS (:BX - :AX)) < 36) ((VALABS (:BY - :AY)) < 30)
FIN

POUR ESSAIM
DONNE "STEP :STEP + 1
LOCAL "SEUIL DONNE "SEUIL 2 + VIVANTS / 2
SI :STEP < :SEUIL [ STOP ]
DONNE "STEP 0
LOCAL "GX DONNE "GX :FX + :DIR * 26
LOCAL "LO DONNE "LO :GX + (MINC) * :AW
LOCAL "HI DONNE "HI :GX + (MAXC) * :AW
SI ET (:DIR < 0) (:LO < 0 - 690) [ DONNE "DIR 1 DONNE "FY :FY - 40 STOP ]
SI ET (:DIR > 0) (:HI > 690) [ DONNE "DIR 0 - 1 DONNE "FY :FY - 40 STOP ]
DONNE "FX :GX
SI (:FY - (MAXLIGNE) * :AH) < :PY + 70 [ DONNE "GA "VRAI ]
SI (VIVANTS) = 0 [ DONNE "WON "VRAI ]
FIN

POUR MAXLIGNE
LOCAL "B DONNE "B 0
REPETEPOUR [ R 0 :ROWS - 1 ] [ REPETEPOUR [ C 0 :COLS - 1 ] [ SI VIVANT? :C :R [ DONNE "B :R ] ] ]
RENDS :B
FIN

POUR BOMBE
LOCAL "NEW DONNE "NEW [ ]
REPETEPOUR [ I 1 (COMPTE :BOMBS) ] [
LOCAL "B DONNE "B ITEM :I :BOMBS
LOCAL "MX DONNE "MX ITEM 1 :B
LOCAL "MY DONNE "MY (ITEM 2 :B) - 16
SI ET ((VALABS (:MX - :PX)) < 34) (:MY < :PY + 26) [ PERTE ] [
SI :MY > 0 - 480 [ DONNE "NEW MD (LISTE :MX :MY) :NEW ]
]
]
DONNE "BOMBS :NEW
SI ET ((COMPTE :BOMBS) < :MAXBOMBS) ((HASARD 5) = 0) [ LARGUE ]
FIN

POUR LARGUE
LOCAL "C DONNE "C HASARD :COLS
SI NON COLVIVE? :C [ STOP ]
LOCAL "R DONNE "R BASDE :C
DONNE "BOMBS MD (LISTE (:FX + :C * :AW) (:FY - :R * :AH - 30)) :BOMBS
FIN

POUR PERTE
DONNE "LIVES :LIVES - 1
SI :LIVES < 1 [ DONNE "GA "VRAI ]
DONNE "PX 0
FIN

POUR PIX :CX :CY :S :C
FCC :C FIXETAILLECRAYON :S
LC FXY :CX :CY BC FXY :CX :CY
FIN

POUR INVADER :CX :CY
FCC :VERT FIXETAILLECRAYON 14
LC FXY :CX - 18 :CY BC FXY :CX + 18 :CY
LC FXY :CX - 12 :CY + 12 BC FXY :CX + 12 :CY + 12
LC FXY :CX - 22 :CY - 12 BC FXY :CX - 14 :CY - 12
LC FXY :CX + 14 :CY - 12 BC FXY :CX + 22 :CY - 12
PIX (:CX - 16) (:CY + 22) 8 :VERT
PIX (:CX + 16) (:CY + 22) 8 :VERT
PIX (:CX - 7) (:CY + 4) 7 :FOND
PIX (:CX + 7) (:CY + 4) 7 :FOND
FIN

POUR SHIP :CX
FCC :CYAN FIXETAILLECRAYON 11
LC FXY :CX - 8 :PY + 6 BC FXY :CX - 44 :PY - 6
LC FXY :CX + 8 :PY + 6 BC FXY :CX + 44 :PY - 6
LC FXY :CX - 40 :PY - 8 BC FXY :CX - 30 :PY - 8
LC FXY :CX + 30 :PY - 8 BC FXY :CX + 40 :PY - 8
FIXETAILLECRAYON 18
LC FXY :CX :PY + 2 BC FXY :CX :PY + 22
FIXETAILLECRAYON 9
LC FXY :CX :PY + 22 BC FXY :CX :PY + 44
PIX :CX (:PY + 12) 9 :BLANC
FIN

POUR RENDU
REPETEPOUR [ R 0 :ROWS - 1 ] [ REPETEPOUR [ C 0 :COLS - 1 ] [
SI VIVANT? :C :R [ INVADER (:FX + :C * :AW) (:FY - :R * :AH) ]
] ]
SI NON :GA [ SHIP :PX ]
SI :BACT [ FCC :BLANC FIXETAILLECRAYON 6 LC FXY :BX :BY BC FXY :BX :BY + 26 ]
FCC :ROUGE FIXETAILLECRAYON 6
REPETEPOUR [ I 1 (COMPTE :BOMBS) ] [ LOCAL "B DONNE "B ITEM :I :BOMBS LC FXY (ITEM 1 :B) (ITEM 2 :B) BC FXY (ITEM 1 :B) (ITEM 2 :B) - 22 ]
INFOS
FIN

POUR INFOS
FCC :TXT
LC FXY 0 - 700 460 BC ETIQUETTE PHRASE "SCORE :SCORE
LC FXY 480 460 BC ETIQUETTE PHRASE "LIVES :LIVES
FIN

POUR FINJEU
FCC :TXT
SI :WON [ LC FXY 0 - 80 20 BC ETIQUETTE "WIN STOP ]
LC FXY 0 - 130 20 BC ETIQUETTE [ GAME OVER ]
FIN
