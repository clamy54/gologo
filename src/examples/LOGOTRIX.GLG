POUR START
PREPARE
TANTQUE [ NON :GA ] [ COMMANDE GRAVITE SCENE [ NETTOIE RENDU ] ATTENDS 3 ]
SCENE [ NETTOIE RENDU FINJEU ]
FIN

POUR PREPARE
VE CT FEN
DONNE "CELL 42
DONNE "BX0 0 - 210
DONNE "BY0 420
DONNE "MUR [ 92 120 56 ]
DONNE "BLOC [ 150 182 92 ]
DONNE "BLOCIN [ 96 124 56 ]
DONNE "TXT [ 150 182 92 ]
FCFG [ 24 36 26 ]
DONNE "SCORE 0
DONNE "LIGNES 0
DONNE "GA "FAUX
DONNE "GRAV 0
DONNE "ODH 0
DONNE "OUP "FAUX
DONNE "HOLD 0
FORMES
GRILLEVIDE
DONNE "SUIV 1 + HASARD 7
NOUVELLE
FIN

POUR FORMES
DONNE "PIECES [
 [ [ 0 1 1 1 2 1 3 1 ] [ 2 0 2 1 2 2 2 3 ] [ 0 2 1 2 2 2 3 2 ] [ 1 0 1 1 1 2 1 3 ] ]
 [ [ 1 0 2 0 1 1 2 1 ] [ 1 0 2 0 1 1 2 1 ] [ 1 0 2 0 1 1 2 1 ] [ 1 0 2 0 1 1 2 1 ] ]
 [ [ 1 0 0 1 1 1 2 1 ] [ 1 0 1 1 2 1 1 2 ] [ 0 1 1 1 2 1 1 2 ] [ 1 0 0 1 1 1 1 2 ] ]
 [ [ 1 0 2 0 0 1 1 1 ] [ 1 0 1 1 2 1 2 2 ] [ 1 1 2 1 0 2 1 2 ] [ 0 0 0 1 1 1 1 2 ] ]
 [ [ 0 0 1 0 1 1 2 1 ] [ 2 0 1 1 2 1 1 2 ] [ 0 1 1 1 1 2 2 2 ] [ 1 0 0 1 1 1 0 2 ] ]
 [ [ 0 0 0 1 1 1 2 1 ] [ 1 0 2 0 1 1 1 2 ] [ 0 1 1 1 2 1 2 2 ] [ 1 0 1 1 0 2 1 2 ] ]
 [ [ 2 0 0 1 1 1 2 1 ] [ 1 0 1 1 1 2 2 2 ] [ 0 1 1 1 2 1 0 2 ] [ 0 0 1 0 1 1 1 2 ] ]
]
FIN

POUR GRILLEVIDE
DONNE "GRILLE [ ]
REPETE 20 [ DONNE "GRILLE MD "0000000000 :GRILLE ]
FIN

POUR FRAME :T :R
RENDS ITEM (:R + 1) (ITEM :T :PIECES)
FIN

POUR CASEG :C :L
RENDS ITEM (:C + 1) (ITEM (:L + 1) :GRILLE)
FIN

POUR CHOC? :T :R :C :L
LOCAL "F DONNE "F FRAME :T :R
REPETEPOUR [ K 1 4 ] [
 LOCAL "CC DONNE "CC :C + ITEM (2 * :K - 1) :F
 LOCAL "LL DONNE "LL :L + ITEM (2 * :K) :F
 SI :CC < 0 [ RENDS "VRAI ]
 SI :CC > 9 [ RENDS "VRAI ]
 SI :LL > 19 [ RENDS "VRAI ]
 SI :LL > 0 - 1 [ SI (CASEG :CC :LL) = "1 [ RENDS "VRAI ] ]
]
RENDS "FAUX
FIN

POUR NOUVELLE
DONNE "PT :SUIV
DONNE "SUIV 1 + HASARD 7
DONNE "PR 0
DONNE "PC 3
DONNE "PL 0
SI CHOC? :PT :PR :PC :PL [ DONNE "GA "VRAI ]
FIN

POUR BOUGE :DC
SI NON CHOC? :PT :PR (:PC + :DC) :PL [ DONNE "PC :PC + :DC ]
FIN

POUR TOURNE
LOCAL "NR DONNE "NR :PR + 1
SI :NR > 3 [ DONNE "NR 0 ]
SI NON CHOC? :PT :NR :PC :PL [ DONNE "PR :NR STOP ]
SI NON CHOC? :PT :NR (:PC - 1) :PL [ DONNE "PR :NR DONNE "PC :PC - 1 STOP ]
SI NON CHOC? :PT :NR (:PC + 1) :PL [ DONNE "PR :NR DONNE "PC :PC + 1 STOP ]
FIN

POUR TOMBE :SOFT
DONNE "GRAV 0
SI CHOC? :PT :PR :PC (:PL + 1) [ POSE STOP ]
DONNE "PL :PL + 1
FIN

POUR GRAVITE
DONNE "GRAV :GRAV + 1
SI :GRAV > (VITESSE) - 1 [ TOMBE 0 ]
FIN

POUR NIVEAU
LOCAL "N DONNE "N ENT (:LIGNES / 10)
SI :N > 9 [ DONNE "N 9 ]
RENDS :N
FIN

POUR VITESSE
LOCAL "V DONNE "V 21 - 2 * (NIVEAU)
SI :V < 3 [ DONNE "V 3 ]
RENDS :V
FIN

POUR POSE
LOCAL "F DONNE "F FRAME :PT :PR
REPETEPOUR [ K 1 4 ] [
 LOCAL "CC DONNE "CC :PC + ITEM (2 * :K - 1) :F
 LOCAL "LL DONNE "LL :PL + ITEM (2 * :K) :F
 SI :LL > 0 - 1 [ POSECASE :CC :LL ]
]
EFFLIGNES
NOUVELLE
FIN

POUR POSECASE :C :L
LOCAL "R DONNE "R ITEM (:L + 1) :GRILLE
DONNE "GRILLE SETROW :GRILLE (:L + 1) (SETCAR :R (:C + 1) "1)
FIN

POUR SETCAR :W :I :V
LOCAL "R DONNE "R "
REPETEPOUR [ J 1 (COMPTE :W) ] [ SI :J = :I [ DONNE "R MOT :R :V ] [ DONNE "R MOT :R ITEM :J :W ] ]
RENDS :R
FIN

POUR SETROW :LST :N :VAL
LOCAL "R DONNE "R [ ]
REPETEPOUR [ J 1 (COMPTE :LST) ] [ SI :J = :N [ DONNE "R MD :VAL :R ] [ DONNE "R MD (ITEM :J :LST) :R ] ]
RENDS :R
FIN

POUR PLEINE? :R
REPETEPOUR [ J 1 10 ] [ SI (ITEM :J :R) = "0 [ RENDS "FAUX ] ]
RENDS "VRAI
FIN

POUR EFFLIGNES
LOCAL "NEW DONNE "NEW [ ]
LOCAL "N DONNE "N 0
REPETEPOUR [ L 0 19 ] [
 LOCAL "R DONNE "R ITEM (:L + 1) :GRILLE
 SI PLEINE? :R [ DONNE "N :N + 1 ] [ DONNE "NEW MD :R :NEW ]
]
REPETE :N [ DONNE "NEW MP "0000000000 :NEW ]
DONNE "GRILLE :NEW
SI :N > 0 [ DONNE "LIGNES :LIGNES + :N DONNE "SCORE :SCORE + POINTS :N ]
FIN

POUR POINTS :N
SI :N = 1 [ RENDS 40 ]
SI :N = 2 [ RENDS 100 ]
SI :N = 3 [ RENDS 300 ]
RENDS 1200
FIN

POUR COMMANDE
LOCAL "D DONNE "D MANETTE 0
LOCAL "DH DONNE "DH 0
SI :D = 7 [ DONNE "DH 0 - 1 ]
SI :D = 3 [ DONNE "DH 1 ]
SI :DH = :ODH [ SI NON :DH = 0 [ DONNE "HOLD :HOLD + 1 SI :HOLD > 5 [ BOUGE :DH DONNE "HOLD 3 ] ] ] [ DONNE "HOLD 0 SI NON :DH = 0 [ BOUGE :DH ] ]
DONNE "ODH :DH
LOCAL "UP DONNE "UP :D = 1
SI ET :UP (NON :OUP) [ TOURNE ]
DONNE "OUP :UP
SI :D = 5 [ TOMBE 1 ]
FIN

POUR RENDU
CADRE
GRILLEDESS
SI NON :GA [ PIECEDESS ]
APERCU
INFOS
FIN

POUR CADRE
LOCAL "XL DONNE "XL :BX0 - 5
LOCAL "XR DONNE "XR :BX0 + 10 * :CELL + 5
LOCAL "YT DONNE "YT :BY0 + 5
LOCAL "YB DONNE "YB :BY0 - 20 * :CELL - 5
FCC :MUR FIXETAILLECRAYON 6
LC FXY :XL :YT BC FXY :XL :YB FXY :XR :YB FXY :XR :YT
FIN

POUR GRILLEDESS
REPETEPOUR [ L 0 19 ] [ REPETEPOUR [ C 0 9 ] [ SI (CASEG :C :L) = "1 [ BLOCC :C :L ] ] ]
FIN

POUR PIECEDESS
LOCAL "F DONNE "F FRAME :PT :PR
REPETEPOUR [ K 1 4 ] [
 LOCAL "CC DONNE "CC :PC + ITEM (2 * :K - 1) :F
 LOCAL "LL DONNE "LL :PL + ITEM (2 * :K) :F
 SI :LL > 0 - 1 [ BLOCC :CC :LL ]
]
FIN

POUR BLOCC :C :L
LOCAL "CX DONNE "CX :BX0 + :C * :CELL + :CELL / 2
LOCAL "CY DONNE "CY :BY0 - :L * :CELL - :CELL / 2
CARRE :CX :CY :CELL - 4 :BLOC
CARRE :CX :CY :CELL - 22 :BLOCIN
FIN

POUR CARRE :CX :CY :S :C
FCC :C FIXETAILLECRAYON 6
LOCAL "Y DONNE "Y :CY - :S / 2
TANTQUE [ :Y < :CY + :S / 2 + 1 ] [ LC FXY :CX - :S / 2 :Y BC FXY :CX + :S / 2 :Y DONNE "Y :Y + 5 ]
FIN

POUR APERCU
LOCAL "F DONNE "F FRAME :SUIV 0
REPETEPOUR [ K 1 4 ] [
 LOCAL "CX DONNE "CX 370 + (ITEM (2 * :K - 1) :F) * 30
 LOCAL "CY DONNE "CY 265 - (ITEM (2 * :K) :F) * 30
 CARRE :CX :CY 26 :BLOC
 CARRE :CX :CY 12 :BLOCIN
]
FIN

POUR INFOS
FCC :TXT
LC FXY 300 410 BC ETIQUETTE "LOGOTRIX
LC FXY 300 360 BC ETIQUETTE "NEXT
LC FXY 300 200 BC ETIQUETTE "SCORE
LC FXY 300 168 BC ETIQUETTE :SCORE
LC FXY 300 120 BC ETIQUETTE "LINES
LC FXY 300 88 BC ETIQUETTE :LIGNES
LC FXY 300 40 BC ETIQUETTE "LEVEL
LC FXY 300 8 BC ETIQUETTE NIVEAU
FIN

POUR FINJEU
FCC :TXT
LC FXY 0 - 100 20 BC ETIQUETTE [ GAME OVER ]
FIN
