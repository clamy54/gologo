POUR VOIEX :L
RENDS :XG + :DEMIVOIE + :L * :LARGVOIE
FIN

POUR CHRONO :REM
DONNE "MN ENT :REM / 60
DONNE "SC RESTE :REM 60
DONNE "SCW :SC
SI :SC < 10 [ DONNE "SCW MOT 0 :SC ]
RENDS MOT ( MOT :MN CAR 58 ) :SCW
FIN

POUR ROUTE
FCC [ 70 72 80 ] FIXETAILLECRAYON :ROUTEPX
LC FXY :CX 760 BC FXY :CX -760 LC
FIN

POUR TRAIT :X
DONNE "Y 500 - RESTE :SCROLL 160
TANTQUE [ :Y > -500 ] [
LC FXY :X :Y BC FXY :X :Y - 80 LC
DONNE "Y :Y - 160
]
FIN

POUR MARQUAGE
FCC [ 235 235 235 ] FIXETAILLECRAYON 5
TRAIT :XG
TRAIT :XD
FIN

POUR DECOR
FIXETORTUE 5 CT NETTOIE
ROUTE
MARQUAGE
FCC 7 LC
FXY 300 320 ETIQUETTE [ TIME ]
FXY 300 240 ETIQUETTE CHRONO :REM
FXY 300 90 ETIQUETTE [ SCORE ]
FCC [ 250 230 90 ]
FXY 300 10 ETIQUETTE :SCORE
FIN

POUR JOUEUR
DONNE "D MANETTE 0
DONNE "H 0
SI :D = 2 [ DONNE "H 1 ]
SI :D = 3 [ DONNE "H 1 ]
SI :D = 4 [ DONNE "H 1 ]
SI :D = 6 [ DONNE "H -1 ]
SI :D = 7 [ DONNE "H -1 ]
SI :D = 8 [ DONNE "H -1 ]
SI :HPREC = 0 [ SI NON :H = 0 [ DONNE "LANE :LANE + :H ] ]
SI :LANE < 0 [ DONNE "LANE 0 ]
SI :LANE > 4 [ DONNE "LANE 4 ]
DONNE "HPREC :H
SI :D = 1 [ DONNE "V :V + 1 ]
SI :D = 2 [ DONNE "V :V + 1 ]
SI :D = 8 [ DONNE "V :V + 1 ]
SI :D = 4 [ DONNE "V :V - 1 ]
SI :D = 5 [ DONNE "V :V - 1 ]
SI :D = 6 [ DONNE "V :V - 1 ]
SI :V < :VMIN [ DONNE "V :VMIN ]
SI :V > :VMAX [ DONNE "V :VMAX ]
FIXETORTUE 0 FXY ( VOIEX :LANE ) :PY
FIN

POUR ENNEMIS
REPETEPOUR [ K 1 :NENN ] [
FIXETORTUE :K
DONNE "Y YCOR - :V
SI :Y < -470 [ DONNE "Y :Y + :PERIODE FXY ( VOIEX HASARD 5 ) :Y ] [ FXY XCOR :Y ]
SI :Y > 475 [ CT ] [ MT ]
]
FIN

POUR CHOCS
REPETEPOUR [ K 1 :NENN ] [
SI COLLISION? LISTE 0 :K [ DONNE "V :VMIN DONNE "FLASH 6 ]
]
FIN

POUR TEINTE
FIXETORTUE 0
SI :FLASH > 0 [ FCC [ 250 230 60 ] DONNE "FLASH :FLASH - 1 ] [ FCC 7 ]
FIN

POUR PREPARE
VE CT FEN
FCFG [ 45 115 55 ]
DONNE "XG -640
DONNE "XD 0
DONNE "LARGVOIE 128
DONNE "DEMIVOIE 64
DONNE "CX -320
DONNE "ROUTEPX 384
DONNE "PY -360
DONNE "VMIN 5
DONNE "VMAX 34
DONNE "V 9
DONNE "NENN 6
DONNE "ECART 240
DONNE "PERIODE :ECART * :NENN
DONNE "LANE 2
DONNE "HPREC 0
DONNE "SCORE 0
DONNE "SCROLL 0
DONNE "FLASH 0
DONNE "DUREE 60
DONNE "F 0
DONNE "REM :DUREE
FIXETORTUE 0 SPRITE 2 FCC 7 LC MT
FXY ( VOIEX :LANE ) :PY
REPETEPOUR [ K 1 :NENN ] [
FIXETORTUE :K SPRITE 2 FCC [ 235 70 55 ] LC CT
FXY ( VOIEX HASARD 5 ) ( -470 + :K * :ECART )
]
FIN

POUR ATTENTE :MSG
SCENE [
DECOR
FCC 7 LC
FXY 300 -120 ETIQUETTE :MSG
FXY 300 -200 ETIQUETTE [ SPACE TO START ]
]
DONNE "K LISCAR
FIN

POUR START
PREPARE
ATTENTE [ TOP RACER ]
DONNE "F 0
DONNE "REM :DUREE
TANTQUE [ :REM > 0 ] [
SCENE [
JOUEUR
ENNEMIS
CHOCS
TEINTE
DONNE "SCORE :SCORE + ENT :V / 4
DONNE "SCROLL :SCROLL + :V
DONNE "F :F + 1
DONNE "REM :DUREE - ENT :F / 30
DECOR
]
ATTENDS 2
]
SCENE [
DECOR
FCC [ 250 230 60 ] LC
FXY 300 -120 ETIQUETTE [ TIME UP ]
FXY 300 -200 ETIQUETTE [ FINAL SCORE ]
FXY 300 -270 ETIQUETTE :SCORE
]
FIN
