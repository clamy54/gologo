POUR FORMECAR :C
LOCAL "K
DONNE "K ASCII :C
SI :K > 64 [ SI :K < 91 [ RENDS :K - 62 ] ]
SI :K > 47 [ SI :K < 58 [ RENDS :K - 19 ] ]
SI :K = 46 [ RENDS 40 ]
SI :K = 44 [ RENDS 41 ]
SI :K = 33 [ RENDS 42 ]
SI :K = 63 [ RENDS 43 ]
SI :K = 39 [ RENDS 44 ]
SI :K = 45 [ RENDS 45 ]
RENDS 39
FIN

POUR TITRE
FIXETORTUE 0 FCC 3 LC
FXY -70 40 ETIQUETTE "GOLOGO
FXY -152 -10 ETIQUETTE [ BY CYRIL LAMY ]
FIN

POUR POSETEXTE
DONNE "N 0
POURCHAQUE "MOT :TEXTE [
POURCHAQUE "C :MOT [
DONNE "N :N + 1
FIXETORTUE :N SPRITE FORMECAR :C FCC 1 LC CT
]
DONNE "N :N + 1
FIXETORTUE :N SPRITE 39 FCC 1 LC CT
]
DONNE "NCAR :N
FIN

POUR PASSCROLL
DONNE "S :S + :PAS
SI :S > :L [ DONNE "S :S - :L ]
REPETE :NCAR [
DONNE "P COMPTEUR * :SP - :S
SI :P < 0 [ DONNE "P :P + :L ]
DONNE "X :P - 850
FIXETORTUE COMPTEUR CT
SI :X > -790 [ SI :X < 790 [
DONNE "A :X * 0.6
DONNE "Y -380 + 40 * SIN :A
FXY :X :Y MT
] ]
]
FIN

POUR START
VE CT FCFG 0
POLICE
TITRE
DONNE "TEXTE [ *************** GOLOGO IS A FUN, COLORFUL REBOOT OF CLASSIC LOGO, MADE FOR MODERN COMPUTERS BUT FULL OF OLD-SCHOOL CHARM. IT BRINGS BACK THE JOY OF TURTLE GRAPHICS, SIMPLE COMMANDS, AND CREATIVE PLAY, WITH THE FEELING OF A VINTAGE COMPUTER LAB AND THE SMOOTHNESS OF A MODERN APP. IT IS A LITTLE BIT RETRO, A LITTLE BIT TOYBOX, AND A WHOLE LOT OF FUN TO EXPLORE ... *************** ]
DONNE "SP 26
DONNE "PAS 6
POSETEXTE
DONNE "L :NCAR * :SP
DONNE "S 0
TANTQUE [ NON TOUCHE? ] [ PASSCROLL ATTENDS 1 ]
FIN
