POUR TERMEB :V
SI :V < 0 [ RENDS PHRASE "- ( 0 - :V ) ]
RENDS PHRASE "+ :V
FIN

POUR GRADX
DONNE "U 1
TANTQUE [ ( :U * :ECH ) <= :XMAX ] [
DONNE "X :U * :ECH
LC FXY :X -8 BC FXY :X 8
LC FXY ( 0 - :X ) -8 BC FXY ( 0 - :X ) 8
SI ( RESTE :U 2 ) = 0 [
LC FXY :X - 8 -40 ETIQUETTE :U
LC FXY ( 0 - :X ) - 16 -40 ETIQUETTE ( 0 - :U )
]
DONNE "U :U + 1
]
FIN

POUR GRADY
DONNE "U 1
TANTQUE [ ( :U * :ECH ) <= :YMAX ] [
DONNE "Y :U * :ECH
LC FXY -8 :Y BC FXY 8 :Y
LC FXY -8 ( 0 - :Y ) BC FXY 8 ( 0 - :Y )
SI ( RESTE :U 2 ) = 0 [
LC FXY -44 :Y - 8 ETIQUETTE :U
LC FXY -52 ( 0 - :Y ) - 8 ETIQUETTE ( 0 - :U )
]
DONNE "U :U + 1
]
FIN

POUR AXES
FIXETORTUE 0 CT
FCC 0 FIXETAILLECRAYON 3
LC FXY :XMIN 0 BC FXY :XMAX 0
LC FXY 0 :YMIN BC FXY 0 :YMAX
LC FIXETAILLECRAYON 2
GRADX
GRADY
LC FXY :XMAX - 36 20 ETIQUETTE "X
LC FXY 16 :YMAX - 28 ETIQUETTE "Y
FIN

POUR COURBE
FCC 4 FIXETAILLECRAYON 4 LC
DONNE "PX :XMIN
TANTQUE [ :PX <= :XMAX ] [
DONNE "SY ( :A * :PX ) + ( :B * :ECH )
SI ( VALABS :SY ) > :YMAX [ LC ] [ FXY :PX :SY BC ]
DONNE "PX :PX + 4
]
LC
FIN

POUR LEGENDE
FCC 4 LC FXY :XMIN + 20 :YMAX - 24
ETIQUETTE ( PHRASE "Y "= :A "X TERMEB :B )
FIN

POUR START
ECRIS [ Y = A X + B ]
LIS [ VALEUR DE A ] "A
LIS [ VALEUR DE B ] "B
VE CT FCFG 7 NETTOIE
DONNE "XMAX 680
DONNE "XMIN 0 - :XMAX
DONNE "YMAX 440
DONNE "YMIN 0 - :YMAX
DONNE "ECH 60
AXES
COURBE
LEGENDE
FIN
