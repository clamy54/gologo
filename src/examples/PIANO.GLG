POUR RECT :XG :YB :XD :YH
LC
DONNE "Y :YB
TANTQUE [ :Y < :YH ] [
FXY :XG :Y
BC
FXY :XD :Y
LC
DONNE "Y :Y + 4
]
FIN

POUR XBLANCHE :I
RENDS -600 + ( :I - 1 ) * 200
FIN

POUR XNOIRE :J
SI :J = 1 [ RENDS -500 ]
SI :J = 2 [ RENDS -300 ]
SI :J = 3 [ RENDS 100 ]
SI :J = 4 [ RENDS 300 ]
RENDS 500
FIN

POUR NOTEBLANCHE :I
SI :I = 1 [ RENDS "DO ]
SI :I = 2 [ RENDS "RE ]
SI :I = 3 [ RENDS "MI ]
SI :I = 4 [ RENDS "FA ]
SI :I = 5 [ RENDS "SOL ]
SI :I = 6 [ RENDS "LA ]
RENDS "SI
FIN

POUR NOTENOIRE :J
SI :J = 1 [ RENDS "DO# ]
SI :J = 2 [ RENDS "RE# ]
SI :J = 3 [ RENDS "FA# ]
SI :J = 4 [ RENDS "SOL# ]
RENDS "LA#
FIN

POUR DESSINE
REPETEPOUR [ I 1 7 ] [
DONNE "X XBLANCHE :I
SI :ACTIVE = :I [ FCC 1 ] [ FCC 7 ]
RECT :X - 90 -350 :X + 90 300
FCC 0 LC FXY :X - 18 -320 ETIQUETTE ITEM :I "QSDFGHJ
]
REPETEPOUR [ J 1 5 ] [
DONNE "X XNOIRE :J
SI :ACTIVE = 10 + :J [ FCC 1 ] [ FCC [ 60 60 60 ] ]
RECT :X - 55 20 :X + 55 300
FCC 7 LC FXY :X - 18 50 ETIQUETTE ITEM :J "ZETYU
]
FIN

POUR FRAPPE :CODE :NOTE
DONNE "ACTIVE :CODE
DESSINE
JOUE :NOTE
DONNE "ACTIVE 0
DESSINE
FIN

POUR JOUERTOUCHE
DONNE "K MAJUSCULE LISCAR
SI ( ASCII :K ) = 32 [ DONNE "FINI VRAI ]
REPETEPOUR [ I 1 7 ] [ SI ( ITEM :I "QSDFGHJ ) = :K [ FRAPPE :I NOTEBLANCHE :I ] ]
REPETEPOUR [ J 1 5 ] [ SI ( ITEM :J "ZETYU ) = :K [ FRAPPE 10 + :J NOTENOIRE :J ] ]
FIN

POUR START
VE CT FCFG 0
FIXETAILLECRAYON 4
OCTAVE 4 DUREE 24 TEMPO 5
DONNE "ACTIVE 0
DESSINE
FCC 7 LC FXY -230 420 ETIQUETTE [ PRESS SPACE TO QUIT ]
DONNE "FINI FAUX
TANTQUE [ NON :FINI ] [ JOUERTOUCHE ]
FIN
