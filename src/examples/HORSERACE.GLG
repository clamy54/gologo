POUR LANE :I
RENDS 320 - ( :I - 1 ) * 160
FIN

POUR COLOR :I
SI :I = 1 [ RENDS 1 ]
SI :I = 2 [ RENDS 3 ]
SI :I = 3 [ RENDS 4 ]
SI :I = 4 [ RENDS 5 ]
RENDS 15
FIN

POUR TRACK
FCFG [ 56 142 60 ]
FIXETORTUE 0 CT FCC 7 LC
FXY -760 -480 BC FXY -760 480 LC
FXY 760 -480 BC FXY 760 480 LC
FIN

; numero de chaque cheval, juste a droite de la ligne d'arrivee, sur sa voie
POUR NUMBERS
FIXETORTUE 0 FCC 7 LC
REPETEPOUR [ I 1 5 ] [ FXY 767 ( LANE :I ) + 22 ETIQUETTE :I ]
FIN

POUR SETHORSES
REPETEPOUR [ I 1 5 ] [
FIXETORTUE :I FCC COLOR :I SPRITE 3 LC FXY -780 LANE :I MT
]
FIN

POUR COUNTDOWN
FIXETORTUE 0 FCC 7 LC
FXY -160 455 ETIQUETTE "3 ATTENDS 60
FXY -100 455 ETIQUETTE "2 ATTENDS 60
FXY -40 455 ETIQUETTE "1 ATTENDS 60
FXY 20 455 ETIQUETTE [ START! ] ATTENDS 60
FIN

POUR RACE
DONNE "WINNER 0
TANTQUE [ :WINNER = 0 ] [
REPETEPOUR [ I 1 5 ] [
FIXETORTUE :I
FXY XCOR + ( HASARD 0 5 ) YCOR
SPRITE 3 + RESTE ENT ( ( XCOR + 800 ) / 12 ) 2
SI XCOR > 730 [ DONNE "WINNER :I ]
]
ATTENDS 1
]
RENDS :WINNER
FIN

; rend le texte FR ou EN selon la langue en cours
POUR MSG :FR :EN
SI LANGUE = "FR [ RENDS :FR ]
RENDS :EN
FIN

; rend un element au hasard d'une liste
POUR ONEOF :LST
RENDS ITEM ( HASARD 1 COMPTE :LST ) :LST
FIN

; pioche une phrase au hasard dans la liste et l'affiche
POUR SAY :LST
ECRIS ONEOF :LST
FIN

; demande la mise. refuse ce qui n'est pas un nombre, en dessous de 1,
; ou plus gros que le porte-monnaie. les sous ne tombent pas du ciel.
POUR ASKAMOUNT
ECRIS ( PHRASE MSG [ TU AS ] [ YOU HAVE ] :CASH MSG [ DOLLARS . COMBIEN VEUX TU MISER ? ] [ DOLLARS . HOW MUCH DO YOU BET ? ] )
DONNE "N LISMOT
SI NON NOMBRE? :N [ ECRIS MSG [ TAPE UN NOMBRE , VOYONS . ] [ TYPE A NUMBER , PLEASE . ] RENDS ASKAMOUNT ]
DONNE "N ENT :N
SI :N < 1 [ ECRIS MSG [ IL FAUT MISER AU MOINS 1 DOLLAR . ] [ YOU MUST BET AT LEAST 1 DOLLAR . ] RENDS ASKAMOUNT ]
SI :N > :CASH [ ECRIS MSG [ TU NE PEUX PAS MISER PLUS QUE TON ARGENT . ] [ YOU CANNOT BET MORE THAN YOU HAVE . ] RENDS ASKAMOUNT ]
RENDS :N
FIN

; choisit un cheval de 1 a 5 (un seul chiffre tape au clavier)
POUR PICKHORSE
ECRIS MSG [ SUR QUEL CHEVAL ? TAPE UN CHIFFRE DE 1 A 5 . ] [ WHICH HORSE ? TYPE A DIGIT FROM 1 TO 5 . ]
DONNE "K ASCII LISCAR
SI :K > 48 [ SI :K < 54 [ RENDS :K - 48 ] ]
RENDS PICKHORSE
FIN

; on rejoue ? O/OUI ou Y/YES pour continuer, N pour quitter l'hippodrome
POUR REJOUE?
ECRIS MSG [ ENCORE UNE COURSE ? O = OUI , N = NON . ] [ ANOTHER RACE ? Y = YES , N = NO . ]
DONNE "K MAJUSCULE LISCAR
SI :K = "O [ RENDS "VRAI ]
SI :K = "Y [ RENDS "VRAI ]
SI :K = "N [ RENDS "FAUX ]
RENDS REJOUE?
FIN

POUR WIN
DONNE "CASH :CASH + :BET
SAY WINLINES
FIN

POUR LOSE
DONNE "CASH :CASH - :BET
SAY LOSELINES
FIN

POUR SHOWCASH
ECRIS ( PHRASE MSG [ IL TE RESTE ] [ YOU NOW HAVE ] :CASH MSG [ DOLLARS . ] [ DOLLARS . ] )
FIN

